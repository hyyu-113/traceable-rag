# 应用与存储
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=data
UPLOAD_DIR=data/uploads
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=traceable_chunks

# 语言模型：填写兼容聊天接口的地址前缀、密钥与模型名称。
# 地址前缀由服务商规定，不包含 /chat/completions。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# 向量模型：与语言模型分别配置，地址不包含 /embeddings。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 可选重排序：关闭时保留融合排名，启用时填写完整接口地址。
RERANKER_ENABLED=false
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

# 检索数量与文本处理参数
TOP_K_BM25=20
TOP_K_VECTOR=20
TOP_K_RRF=12
TOP_K_RERANK=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=20
REQUEST_TIMEOUT=60
VECTOR_MIN_SCORE=0.25
